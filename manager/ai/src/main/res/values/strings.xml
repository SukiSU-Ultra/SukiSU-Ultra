    <string name="ai_disclaimer_title">AI assistant disclaimer</string>
    <string name="ai_disclaimer_body">The AI assistant can read manager state and, when you grant a scope, change theme, extension or superuser settings and run root-related operations. AI output may be inaccurate, incomplete or unsafe; verify every change before applying it. You are solely responsible for how you use this assistant and for all consequences. Any misuse, improper use or damage is unrelated to the developer and maintainers; you assume the risk yourself. Only use it on devices you own or are authorized to manage, and comply with applicable laws.</string>
    <string name="ai_disclaimer_check">I have read and agree to the disclaimer above, and I accept responsibility for any risk.</string>
    <string name="ai_disclaimer_accept">Agree and continue</string>
    <string name="ai_disclaimer_exit">Exit</string>
    <string name="ai_risk_title">Confirm risky permission</string>
    <string name="ai_risk_check">I understand the risk and accept responsibility.</string>
    <string name="ai_risk_confirm">Enable</string>
    <string name="ai_risk_cancel">Cancel</string>
    <string name="ai_risk_body_root">Root access lets the assistant run root-backed tools. Incorrect changes can break the device, expose data or weaken security.</string>
    <string name="ai_risk_body_permanent_root">The assistant can grant or revoke permanent root for an app. This gives the app full root access and affects every package sharing its UID.</string>
    <string name="ai_risk_body_temporary_root">The assistant can grant temporary root for up to 7 days. The app can perform any root action until the lease expires or is revoked.</string>
    <string name="ai_risk_body_global_su">The assistant can switch su globally. disable_always breaks su for every app until you re-enable it.</string>
    <string name="ai_risk_body_extension_write">The assistant can change kernel-level extensions, including KPM, CPU/version spoof, umount paths, dynamic manager and SuSFS. Incorrect changes can hide mounts, break modules or affect stability.</string>
    <string name="ai_risk_body_module_install">The assistant can download and install modules. A malicious or incompatible module can break boot or compromise the device.</string>
    <string name="ai_risk_body_code_execution">The assistant can propose shell code blocks and run them with the root shell provided by the manager after your confirmation. Commands can change any file or setting.</string>
    <string name="ai_risk_body_advanced_api">Advanced API mode exposes request timeouts, retries, generation parameters, custom HTTP headers and raw request-body overrides. Incorrect values can break every request, send data to the wrong endpoint, or expose your API key. Only enable this if you understand the provider API;</string>
    <string name="ai_advanced_mode">Advanced API mode</string>
    <string name="ai_advanced_mode_summary">Expert-only request options. Hidden until enabled; requires typing a confirmation phrase.</string>
    <string name="ai_advanced_phrase">Type ADVANCED to confirm</string>
    <string name="ai_advanced_phrase_hint">ADVANCED</string>
    <string name="ai_advanced_options">Advanced options JSON</string>
    <string name="ai_advanced_options_hint">JSON object; see the help text for supported keys.</string>
    <string name="ai_advanced_options_help">Keys: maxOutputTokens, temperature, topP, frequencyPenalty, presencePenalty, seed, stop, maxToolRounds, maxHistoryTurns, maxHistoryChars, connectTimeoutSeconds, readTimeoutSeconds, writeTimeoutSeconds, callTimeoutSeconds, retryCount, parallelToolCalls, headers, extraBody. Invalid JSON is rejected before saving; safe defaults are used if a stored value cannot be parsed.</string>
