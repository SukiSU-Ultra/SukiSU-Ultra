    <string name="ai_risk_title">确认危险权限</string>
    <string name="ai_risk_check">我已了解相关风险，并自行承担责任。</string>
    <string name="ai_risk_confirm">启用</string>
    <string name="ai_risk_cancel">取消</string>
    <string name="ai_risk_body_root">允许助手使用 root 工具。错误操作可能损坏设备、泄露数据或降低系统安全性。</string>
    <string name="ai_risk_body_permanent_root">允许助手为指定应用授予或撤销永久 root。该应用将获得完整 root 权限，并会影响所有共享同一 UID 的应用。</string>
    <string name="ai_risk_body_temporary_root">允许助手授予最长 7 天的临时 root。在租约到期或被撤销前，该应用可以执行任意 root 操作。</string>
    <string name="ai_risk_body_global_su">允许助手切换全局 su。选择“永久禁用”会让所有应用都无法使用 su，直到你重新启用。</string>
    <string name="ai_risk_body_extension_write">允许助手修改内核级扩展，包括 KPM、CPU/版本伪装、umount 路径、动态管理器和 SuSFS。错误操作可能导致挂载隐藏、模块失效或系统不稳定。</string>
    <string name="ai_risk_body_module_install">允许助手下载并安装模块。恶意或不兼容的模块可能导致无法开机或设备被入侵。</string>
    <string name="ai_risk_body_code_execution">允许助手提供 shell 代码块，并在你确认后使用管理器的 root shell 执行。命令可以修改任意文件或设置。</string>
    <string name="ai_risk_body_advanced_api">高级 API 模式会开放请求超时、重试、生成参数、自定义 HTTP 请求头和原始请求体覆盖。错误的值可能导致所有请求失败、把数据发往错误地址或泄露 API Key。仅在你了解服务商 API 时启用</string>
    <string name="ai_advanced_mode">高级 API 模式</string>
    <string name="ai_advanced_mode_summary">仅限专家的请求选项。默认隐藏，启用时需要输入确认短语。</string>
    <string name="ai_advanced_phrase">输入 ADVANCED 以确认</string>
    <string name="ai_advanced_phrase_hint">ADVANCED</string>
    <string name="ai_advanced_options">高级选项 JSON</string>
    <string name="ai_advanced_options_hint">JSON 对象；支持的键见帮助文本。</string>
    <string name="ai_advanced_options_help">键：maxOutputTokens、temperature、topP、frequencyPenalty、presencePenalty、seed、stop、maxToolRounds、maxHistoryTurns、maxHistoryChars、connectTimeoutSeconds、readTimeoutSeconds、writeTimeoutSeconds、callTimeoutSeconds、retryCount、parallelToolCalls、headers、extraBody。无效 JSON 会在保存前被拒绝；已存值无法解析时使用安全默认值。</string>
